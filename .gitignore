*.log
.env*
.DS_Store
*.tsbuildinfo
next-env.d.ts
dev.log
server.log

# tooling
.claude
.z-ai-config
.zscripts

# zips staged for browser download via the dev/preview server
port/public/_downloads

# sandbox-only transport service
/mini-services
