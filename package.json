{
  "name": "ichoruous-web",
  "version": "1.0.0",
  "private": true,
  "description": "Ichorous (GameMaker, x64) statically recompiled to WebAssembly, running in the browser as a plain static site — no framework, no build step, no dependencies.",
  "scripts": {
    "start": "node tools/serve-static.mjs . --port 8080",
    "serve": "node tools/serve-static.mjs . --port 8080",
    "smoke": "node --max-old-space-size=2048 tools/smoke.mjs 300",
    "verify:loader": "node tools/verify_loader.mjs",
    "verify": "npm run smoke && npm run verify:loader",

    "gex:harness": "node tools/gex/harness.js",
    "gex:mine": "node tools/gex/mine.js",
    "gex:minetable": "node tools/gex/minetable.js",
    "gex:build": "node tools/gex/build.js",
    "gex:world": "node tools/gex/extractworld.js",
    "extract": "node tools/extract.mjs",
    "extract:audio": "node tools/extract_audio.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
